APP_NAME=ЧтоХочу
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.chtohochu.test

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chtohochu
DB_USERNAME=chtohochu
DB_PASSWORD=chtohochu

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.chtohochu.test

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail catcher (Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@chtohochu.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media storage (ADR-015): ОДИН физический bucket на все purpose —
# все три S3_BUCKET_* указывают на один и тот же существующий bucket.
# Логическое разделение — object-key prefix'ами (chtohochu-avatars/,
# chtohochu-wish-images/, chtohochu-shopping-images/), см. config/media.php.
S3_BUCKET_AVATARS=
S3_BUCKET_WISH_IMAGES=
S3_BUCKET_SHOPPING_IMAGES=
S3_PUBLIC_BASE_URL=
MEDIA_UPLOAD_TTL_MINUTES=10
MEDIA_MAX_UPLOAD_BYTES=5242880

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket)
REVERB_APP_ID=chtohochu-local
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=api.chtohochu.test
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Внутренний endpoint для server-side broadcast (см. config/broadcasting.php).
# В docker-стеке переопределяется на http://reverb:8080 через compose env.
REVERB_SERVER_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

## Local Domains
APP_DOMAIN_LANDING=www.chtohochu.test
APP_DOMAIN_USER=app.chtohochu.test
APP_DOMAIN_ADMIN=admin.chtohochu.test
APP_DOMAIN_API=api.chtohochu.test
APP_DOMAIN_SELLER=seller.chtohochu.test

# Sharing / Smart Links
APP_SHARE_BASE_URL=https://app.chtohochu.ru
APP_STORE_URL=https://apps.apple.com/app/chtohochu/id123456789
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ru.chtohochu.app
DEEP_LINK_SCHEME=chtohochu

# VK OAuth
VK_APP_ID=
VK_APP_SECRET=
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199
VK_REDIRECT_URI=https://api.chtohochu.test/auth/vk/callback

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.chtohochu.test/auth/yandex/callback

# Firebase (push notifications)
FIREBASE_CREDENTIALS=storage/app/private/firebase-key.json
