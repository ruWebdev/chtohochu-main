<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <!-- DB_* форсятся: без force тесты в docker-контейнере
             подхватили бы env compose-стека (DB_DATABASE=chtohochu) и
             migrate:fresh стёр бы дев-базу. CI поднимает postgres
             с этими же кредами и алиасом хоста `postgres`. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_HOST" value="postgres" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="DB_DATABASE" value="chtohochu_testing" force="true"/>
        <server name="DB_USERNAME" value="chtohochu" force="true"/>
        <server name="DB_PASSWORD" value="chtohochu" force="true"/>
        <server name="APP_DOMAIN_API" value="api.chtohochu.test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
