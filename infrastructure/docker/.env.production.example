# =============================================================================
# ЧтоХочу — Production environment template (server: /srv/chtohochu/.env)
# =============================================================================
# This file serves BOTH purposes:
#   1. docker compose variable interpolation (DB_*, REDIS_PASSWORD, TAG)
#   2. Laravel runtime environment via `env_file` on the PHP containers
#
# WARNING: never commit the real .env. Fill every <...> placeholder.
# =============================================================================

# Image tag deployed by CI (git SHA or release tag)
TAG=latest

# ---------------------------------------------------------------------------
# Laravel core
# ---------------------------------------------------------------------------
APP_NAME=ЧтоХочу
APP_ENV=production
# Generate locally: php artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://api.chtohochu.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# PostgreSQL (consumed by the postgres service AND the app)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=chtohochu
DB_USERNAME=chtohochu
DB_PASSWORD=<strong-random-password>

# ---------------------------------------------------------------------------
# Redis (consumed by the redis service AND the app)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-random-password>

# ---------------------------------------------------------------------------
# Sessions / cache / queue / broadcasting / filesystem
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.chtohochu.ru

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Reverb (WebSocket). REVERB_SERVER_* is the internal address the app uses
# to publish events; REVERB_HOST/PORT/SCHEME is the public wss endpoint.
# ---------------------------------------------------------------------------
REVERB_APP_ID=chtohochu-prod
REVERB_APP_KEY=<strong-random-string>
REVERB_APP_SECRET=<strong-random-string>
REVERB_HOST=api.chtohochu.ru
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://app.chtohochu.ru,https://www.chtohochu.ru,https://seller.chtohochu.ru,https://admin.chtohochu.ru

# ---------------------------------------------------------------------------
# Mail — production SMTP (fill with the real provider)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@chtohochu.ru
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
APP_DOMAIN_LANDING=www.chtohochu.ru
APP_DOMAIN_USER=app.chtohochu.ru
APP_DOMAIN_ADMIN=admin.chtohochu.ru
APP_DOMAIN_API=api.chtohochu.ru
APP_DOMAIN_SELLER=seller.chtohochu.ru

APP_SHARE_BASE_URL=https://app.chtohochu.ru
DEEP_LINK_SCHEME=chtohochu

# ---------------------------------------------------------------------------
# OAuth — VK / Yandex (secrets live ONLY here, never in client code)
# ---------------------------------------------------------------------------
VK_APP_ID=
VK_APP_SECRET=
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199
VK_REDIRECT_URI=https://api.chtohochu.ru/auth/vk/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.chtohochu.ru/auth/yandex/callback

# ---------------------------------------------------------------------------
# Firebase (push notifications). Mount the service-account JSON into the
# container or switch to an env-var-based credential source.
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/private/firebase-key.json
